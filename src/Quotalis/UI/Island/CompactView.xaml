<?xml version="1.0" encoding="utf-8"?>
<!-- Compact capsule: 36 DIP tall, width follows content. The featured module, or the classic AI usage summary when nothing is featured. -->
<UserControl
    x:Class="Quotalis.UI.Island.CompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Quotalis.UI.Components">

    <Grid x:Name="Root" Height="36" MinWidth="112" Padding="16,0" Background="Transparent"
          AutomationProperties.Name="{x:Bind ViewModel.CompactAccessibleName, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Featured module (a favorite, or the module opened last). -->
            <StackPanel x:Name="Featured" Orientation="Horizontal" Spacing="7" Visibility="{x:Bind ViewModel.IsFeaturing, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.CompactPrimaryAccessibleName, Mode=OneWay}">
                <Grid Width="20" Height="20" VerticalAlignment="Center">
                    <Grid x:Name="FeaturedIcon" Visibility="{x:Bind ViewModel.CompactPrimaryShowsIcon, Mode=OneWay}">
                        <components:ProviderMark x:Name="FeaturedMark" Width="14" Height="14" />
                        <components:ModuleIcon x:Name="FeaturedModuleIcon" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Hermes: a yellow dot in the logo slot. -->
                        <Ellipse x:Name="FeaturedHermesDot" Width="10" Height="10" Fill="{StaticResource HermesBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <!-- Today's total: one dot per tool, in their colours. -->
                        <Canvas x:Name="FeaturedTotalDots" Width="16" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Ellipse Canvas.Left="4.5" Canvas.Top="0" Width="7" Height="7" Fill="{StaticResource ClaudeBrush}" />
                            <Ellipse Canvas.Left="0" Canvas.Top="8" Width="7" Height="7" Fill="{StaticResource CodexBrush}" />
                            <Ellipse Canvas.Left="9" Canvas.Top="8" Width="7" Height="7" Fill="{StaticResource HermesBrush}" />
                        </Canvas>
                    </Grid>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.CompactPrimaryLabel, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.HasCompactPrimaryLabel, Mode=OneWay}" VerticalAlignment="Center" />
                <!-- Width-stable: "376k" and "1.12M" take the same slot; long text ends in an ellipsis. -->
                <components:StableText Text="{x:Bind ViewModel.CompactPrimaryValue, Mode=OneWay}" MaxWidth="160" VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasCompactPrimaryValue, Mode=OneWay}" />
                <TextBlock Text="·" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextTertiaryBrush}"
                           Visibility="{x:Bind ViewModel.HasCompactPrimaryDetail, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.CompactPrimaryDetail, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.HasCompactPrimaryDetail, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Classic summary when nothing is featured. -->
            <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.CompactShowClaude, Mode=OneWay}">
                <components:ProviderMark Kind="Claude" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="Claude" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                <components:StableText Text="{x:Bind ViewModel.Usage.Claude.CompactValue, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.CompactShowCodex, Mode=OneWay}">
                <components:ProviderMark Kind="Codex" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="Codex" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                <components:StableText Text="{x:Bind ViewModel.Usage.Codex.CompactValue, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Camera and microphone in use: always last, whatever the capsule shows. -->
            <components:PrivacyIndicators Source="{x:Bind ViewModel.Privacy}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
