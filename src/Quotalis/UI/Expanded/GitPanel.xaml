<?xml version="1.0" encoding="utf-8"?>
<!-- Git: the active project's branch, uncommitted changes, sync state and last commit; a few recent repositories below. -->
<UserControl
    x:Class="Quotalis.UI.Expanded.GitPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Quotalis.UI.Components"
    xmlns:local="using:Quotalis.UI.Expanded"
    xmlns:vm="using:Quotalis.ViewModels">

    <Grid>
        <local:ModuleStateView x:Name="StateView" Visibility="{x:Bind ViewModel.ShowState, Mode=OneWay}" />

        <StackPanel Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.AccessibleSummary, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.RepoName, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="24" Padding="10,0" CornerRadius="12" Background="{StaticResource SurfaceRaisedBrush}" MaxWidth="180">
                    <TextBlock Text="{x:Bind ViewModel.BranchText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <TextBlock Text="{x:Bind ViewModel.ChangesFigure, Mode=OneWay}" Style="{StaticResource FigureTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ChangesCaption, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.ChangesDetail, Mode=OneWay}" Style="{StaticResource FineTextStyle}" Margin="0,1,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <FontIcon Glyph="{x:Bind ViewModel.SyncGlyph, Mode=OneWay}" FontSize="12" Style="{StaticResource IconTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.SyncText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <Grid Margin="0,6,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE81C;" FontSize="12" Style="{StaticResource IconTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.LastCommitSubject, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.LastCommitAgo, Mode=OneWay}" Style="{StaticResource FineTextStyle}" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Visibility="{x:Bind ViewModel.HasOthers, Mode=OneWay}" Margin="0,14,0,0">
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Others, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GitRepoRow">
                            <Button Style="{StaticResource IslandRowButtonStyle}" Margin="-10,0" Tag="{x:Bind Root}" Click="OnSelectRepo"
                                    AutomationProperties.Name="{x:Bind Name}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="170" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Branch}" Style="{StaticResource FineTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Changes}" Style="{StaticResource FineTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- soybean-alien's GitHub contributions, like the usage heatmap but in GitHub's greens. -->
            <StackPanel Margin="0,16,0,0" Spacing="6" Visibility="{x:Bind ViewModel.HasContributions, Mode=OneWay}">
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,4" />
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.ContributionsTitle}" Style="{StaticResource FineTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ContributionsTotal, Mode=OneWay}" Style="{StaticResource FineTextStyle}" HorizontalAlignment="Right" />
                </Grid>
                <components:ContributionHeatmap x:Name="Contributions" HorizontalAlignment="Left" />
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.ContributionsSummary, Mode=OneWay}" Style="{StaticResource FineTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                        <TextBlock Text="Less" Style="{StaticResource FineTextStyle}" Margin="0,0,4,0" />
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#FF161B22" />
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#FF0E4429" />
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#FF006D32" />
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#FF26A641" />
                        <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="#FF39D353" />
                        <TextBlock Text="More" Style="{StaticResource FineTextStyle}" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.ContributionsReadout, Mode=OneWay}" Style="{StaticResource FineTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <TextBlock Margin="0,16,0,0" Text="{x:Bind ViewModel.ContributionsNote, Mode=OneWay}" Style="{StaticResource FineTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                       Visibility="{x:Bind ViewModel.HasContributionsNote, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
