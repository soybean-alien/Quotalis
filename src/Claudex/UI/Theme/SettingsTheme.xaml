<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings window theme. Follows the system (or forced dark) theme. Accent: Action Blue on light
    surfaces, Sky Link Blue on dark ones (DESIGN.md), used for toggles and selection only.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SettingsAccentColor">#FF0066CC</Color>
            <Color x:Key="SystemAccentColor">#FF0066CC</Color>
            <Color x:Key="SystemAccentColorLight1">#FF1A7AD9</Color>
            <Color x:Key="SystemAccentColorLight2">#FF4D97E6</Color>
            <Color x:Key="SystemAccentColorLight3">#FF80B5F0</Color>
            <Color x:Key="SystemAccentColorDark1">#FF0059B3</Color>
            <Color x:Key="SystemAccentColorDark2">#FF004C99</Color>
            <Color x:Key="SystemAccentColorDark3">#FF003F80</Color>
            <SolidColorBrush x:Key="SettingsSegmentBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="SettingsSegmentSelectedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF0066CC" />
            <SolidColorBrush x:Key="SettingsCardBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="SettingsCardStrokeBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SettingsDividerBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="SettingsTextPrimaryBrush" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="SettingsTextSecondaryBrush" Color="#FF6E6E73" />
            <SolidColorBrush x:Key="SettingsNavSelectedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SettingsNavHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SettingsScreenBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="SettingsScreenStrokeBrush" Color="#26000000" />
            <SolidColorBrush x:Key="SettingsPillBrush" Color="#33000000" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0066CC" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60066CC" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0066CC" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF0066CC" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E60066CC" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#CC0066CC" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF0066CC" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF0066CC" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF0066CC" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SettingsAccentColor">#FF2997FF</Color>
            <Color x:Key="SystemAccentColor">#FF2997FF</Color>
            <Color x:Key="SystemAccentColorLight1">#FF4DA9FF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF73BCFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FF99CEFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1F85E6</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1A73CC</Color>
            <Color x:Key="SystemAccentColorDark3">#FF1561B3</Color>
            <SolidColorBrush x:Key="SettingsSegmentBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SettingsSegmentSelectedBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF2997FF" />
            <SolidColorBrush x:Key="SettingsCardBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="SettingsCardStrokeBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SettingsDividerBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="SettingsTextPrimaryBrush" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="SettingsTextSecondaryBrush" Color="#FFA1A1A6" />
            <SolidColorBrush x:Key="SettingsNavSelectedBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SettingsNavHoverBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="SettingsScreenBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SettingsScreenStrokeBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SettingsPillBrush" Color="#40FFFFFF" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF2997FF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E62997FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC2997FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF2997FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E62997FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#CC2997FF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF2997FF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF2997FF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF2997FF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Toggles carry no On/Off label, so they need no reserved label width. -->
    <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
    <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
    <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>

    <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource SettingsTextPrimaryBrush}" />
    </Style>
    <Style x:Key="SettingsGroupLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource SettingsTextSecondaryBrush}" />
        <Setter Property="Margin" Value="4,0,0,8" />
    </Style>
    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource SettingsTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource SettingsTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{ThemeResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SettingsCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="SettingsRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,12,12,12" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>
    <Style x:Key="SettingsDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Fill" Value="{ThemeResource SettingsDividerBrush}" />
    </Style>
    <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="48" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Sidebar entry. Selection is a quiet fill, not a colored bar. -->
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource SettingsTextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border x:Name="Hover" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Background" Value="{ThemeResource SettingsNavHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Background" Value="{ThemeResource SettingsNavSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control option (theme picker): a raised pill marks the selection. -->
    <Style x:Key="SegmentedOptionStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource SettingsTextPrimaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Pill" CornerRadius="6" Background="Transparent" />
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" Foreground="{ThemeResource SettingsTextSecondaryBrush}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Background" Value="{ThemeResource SettingsSegmentSelectedBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource SettingsTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Opacity" Value="0.7" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Anchor picker pill on the miniature screen. -->
    <Style x:Key="AnchorPickerButtonStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Pill" Width="30" Height="9" CornerRadius="4.5" Background="{ThemeResource SettingsPillBrush}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Background" Value="{ThemeResource SettingsAccentBrush}" />
                                        <Setter Target="Pill.Width" Value="34" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Pill.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
