<?xml version="1.0" encoding="utf-8"?>
<!-- Compact capsule: 36 DIP tall, width follows content. Focus, AI usage, then music art. -->
<UserControl
    x:Class="DeveloperIsland.UI.Island.CompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Height="36" MinWidth="112" Padding="16,0" Background="Transparent"
          AutomationProperties.Name="{x:Bind ViewModel.CompactAccessibleName, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{x:Bind ViewModel.CompactShowFocus, Mode=OneWay}">
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Focus.RemainingText, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.CompactShowClaude, Mode=OneWay}">
                <TextBlock Text="Claude" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Usage.Claude.CompactValue, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.CompactShowCodex, Mode=OneWay}">
                <TextBlock Text="Codex" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Usage.Codex.CompactValue, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
            </StackPanel>

            <Grid Width="20" Height="20" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CompactShowMusic, Mode=OneWay}">
                <Border CornerRadius="6" Background="{StaticResource SurfaceRaisedBrush}" Visibility="{x:Bind ViewModel.Music.HasNoArt, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8D6;" FontSize="11" Style="{StaticResource IconTextStyle}" />
                </Border>
                <Border CornerRadius="6" Visibility="{x:Bind ViewModel.Music.HasArt, Mode=OneWay}">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind ViewModel.Music.Art, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
