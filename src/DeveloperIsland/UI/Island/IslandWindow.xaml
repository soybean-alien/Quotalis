<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeveloperIsland.UI.Island.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:island="using:DeveloperIsland.UI.Island"
    xmlns:expanded="using:DeveloperIsland.UI.Expanded"
    xmlns:components="using:DeveloperIsland.UI.Components"
    Title="Developer Island">

    <components:CursorGrid x:Name="Root" Background="Transparent">
        <!-- Composition surface: capsule shape and shadow (IslandMorph). -->
        <Grid x:Name="SurfaceHost" IsHitTestVisible="False" />

        <!-- Content, clipped to the animated capsule. -->
        <Grid x:Name="ContentHost">
            <!-- Smart Browser Notch: the island retracted into the top screen edge. -->
            <!-- Camera or microphone in use: tiny dots centered in the visible 5 DIP; the notch keeps its size. -->
            <Grid x:Name="Notch" Width="48" Height="10" Visibility="Collapsed" Background="Transparent"
                  AutomationProperties.Name="Developer Island, retracted. Click to open.">
                <components:PrivacyDots x:Name="NotchPrivacy" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0.5" />
            </Grid>
            <island:CompactView x:Name="Compact" />
            <island:ActivityView x:Name="Activity" Visibility="Collapsed" />
            <expanded:ExpandedView x:Name="Expanded" Visibility="Collapsed" />
        </Grid>
    </components:CursorGrid>
</Window>
