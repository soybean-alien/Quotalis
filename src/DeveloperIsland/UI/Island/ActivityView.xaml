<?xml version="1.0" encoding="utf-8"?>
<!--
    Medium state ("live activity"): 360 x 56 pill (radius 28).
    Leading visual sits at a 10 DIP inset; album art uses radius 10 (smaller than the 18 concentric
    radius, so artwork keeps a recognisable square silhouette), glyph discs are concentric circles.
-->
<UserControl
    x:Class="DeveloperIsland.UI.Island.ActivityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:DeveloperIsland.UI.Components">

    <Grid x:Name="Root" Width="360" Height="56" Padding="10,0,20,0" ColumnSpacing="12" Background="Transparent"
          AutomationProperties.Name="{x:Bind ViewModel.AccessibleText, Mode=OneWay}"
          AutomationProperties.LiveSetting="Polite">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Width="36" Height="36" VerticalAlignment="Center">
            <Border CornerRadius="18" Background="{StaticResource SurfaceRaisedBrush}" Visibility="{x:Bind ViewModel.ShowGlyph, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" FontSize="15" FontFamily="{StaticResource IconFont}"
                          Foreground="{x:Bind ViewModel.GlyphBrush, Mode=OneWay}" />
            </Border>
            <Border CornerRadius="18" Background="{StaticResource SurfaceRaisedBrush}" Visibility="{x:Bind ViewModel.ShowMark, Mode=OneWay}">
                <components:ProviderMark Kind="{x:Bind ViewModel.Mark, Mode=OneWay}" Width="15" Height="15" />
            </Border>
            <Border CornerRadius="18" Background="{StaticResource SurfaceRaisedBrush}" Visibility="{x:Bind ViewModel.ShowModuleIcon, Mode=OneWay}">
                <components:ModuleIcon Module="{x:Bind ViewModel.ModuleIcon, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border CornerRadius="10" Visibility="{x:Bind ViewModel.ShowArt, Mode=OneWay}">
                <Border.Background>
                    <ImageBrush ImageSource="{x:Bind ViewModel.Art, Mode=OneWay}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>

        <components:StableText Grid.Column="2" AlignRight="True" VerticalAlignment="Center" Text="{x:Bind ViewModel.Trailing, Mode=OneWay}"
                               Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="140"
                               Visibility="{x:Bind ViewModel.HasTrailing, Mode=OneWay}" />
    </Grid>
</UserControl>
