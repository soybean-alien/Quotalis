<?xml version="1.0" encoding="utf-8"?>
<!--
    Developer Island design tokens. See docs/design/DESIGN-PRINCIPLES.md.
    The island is always dark (like the Dynamic Island); one accent; weights 400/600 only.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="IslandFillColor">#FF0A0A0B</Color>
    <Color x:Key="IslandHairlineColor">#17FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#10FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#1CFFFFFF</Color>
    <Color x:Key="SurfacePressedColor">#26FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FFF5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#FFA1A1A6</Color>
    <Color x:Key="TextTertiaryColor">#FF7A7A7A</Color>
    <Color x:Key="AccentColor">#FF2997FF</Color>

    <SolidColorBrush x:Key="IslandFillBrush" Color="{StaticResource IslandFillColor}" />
    <SolidColorBrush x:Key="IslandHairlineBrush" Color="{StaticResource IslandHairlineColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#33F5F5F7" />

    <!-- Status colors: semantic only, used as small dots and icons, never as fills. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFD60A" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#FFFF453A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />

    <!-- Type -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="HeroTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-6" />
        <Setter Property="LineHeight" Value="48" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="FigureTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-8" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="-8" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="FineTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="IconTextStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Circular icon button: transparent at rest, raised fill on hover, press scales to 0.94. -->
    <Style x:Key="IslandIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.18" />
                                    <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{StaticResource SurfacePressedBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.32" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The primary transport control sits on a raised disc. -->
    <Style x:Key="IslandPrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandIconButtonStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    </Style>

    <!-- Pill text button (Pause, Stop, presets). -->
    <Style x:Key="IslandPillButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Normal" GeneratedDuration="0:0:0.18" />
                                    <VisualTransition To="PointerOver" GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                        <Setter Target="Content.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{StaticResource SurfacePressedBrush}" />
                                        <Setter Target="Content.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.32" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent pill for the one primary action in a view (Start). -->
    <Style x:Key="IslandAccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandPillButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#FF0A0A0B" />
    </Style>

    <!-- Tab: text only; the selection pill is drawn by the segmented control behind it. -->
    <Style x:Key="IslandTabButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Content}"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter Target="Content.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- A segment of a small segmented control (Plan usage: Current / Weekly). -->
    <Style x:Key="IslandSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandPillButtonStyle}">
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- Favorite star: small, quiet; it never competes with the content it sits next to. -->
    <Style x:Key="IslandStarButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandIconButtonStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- A figure tile in module panels (GitHub counts, System meters). -->
    <Style x:Key="ModuleTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,10,12,11" />
    </Style>

    <!-- A full-width row button (repository list, agenda); hover shows a raised fill. -->
    <Style x:Key="IslandRowButtonStyle" TargetType="Button" BasedOn="{StaticResource IslandPillButtonStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Keyboard focus ring: 2px accent, drawn only for keyboard focus (WinUI system focus visuals). -->
    <StaticResource x:Key="SystemControlFocusVisualPrimaryBrush" ResourceKey="AccentBrush" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#FF0A0A0B" />
</ResourceDictionary>
