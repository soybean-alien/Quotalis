<?xml version="1.0" encoding="utf-8"?>
<!-- The one non-ready view every module shares: icon, a short title, one sentence, at most one action. -->
<UserControl
    x:Class="DeveloperIsland.UI.Expanded.ModuleStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:DeveloperIsland.UI.Components">

    <StackPanel Spacing="0" Padding="0,2,0,2">
        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource SurfaceRaisedBrush}" HorizontalAlignment="Left">
            <components:ModuleIcon x:Name="Icon" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{x:Bind ViewModel.StateTitle, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" Margin="0,12,0,0" />
        <TextBlock Text="{x:Bind ViewModel.StateMessage, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                   TextWrapping="Wrap" TextTrimming="None" MaxLines="3" LineHeight="17" />
        <Button Style="{StaticResource IslandPillButtonStyle}" Content="{x:Bind ViewModel.ActionLabel, Mode=OneWay}" Margin="0,14,0,0"
                Visibility="{x:Bind ViewModel.HasAction, Mode=OneWay}" Click="OnAction" />
    </StackPanel>
</UserControl>
