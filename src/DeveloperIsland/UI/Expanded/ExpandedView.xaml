<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded island: 420 wide, radius 28. Header with text tabs (the selection pill slides between
    them) and a settings button; one module at a time below.
-->
<UserControl
    x:Class="DeveloperIsland.UI.Expanded.ExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeveloperIsland.UI.Expanded">

    <Grid x:Name="Root" Width="420" Padding="16,14,16,18" RowSpacing="16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="32">
            <Grid x:Name="TabHost" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border x:Name="TabIndicator" Height="28" CornerRadius="14" Background="{StaticResource SurfaceRaisedBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="2" AutomationProperties.Name="Sections" TabFocusNavigation="Once">
                    <Button x:Name="UsageTab" Style="{StaticResource IslandTabButtonStyle}" Content="Usage" Tag="Usage" Click="OnTabClick"
                            Visibility="{x:Bind ViewModel.IsUsageTabAvailable, Mode=OneWay}" KeyDown="OnTabKeyDown" />
                    <Button x:Name="MusicTab" Style="{StaticResource IslandTabButtonStyle}" Content="Music" Tag="Music" Click="OnTabClick"
                            Visibility="{x:Bind ViewModel.IsMusicTabAvailable, Mode=OneWay}" KeyDown="OnTabKeyDown" />
                    <Button x:Name="FocusTab" Style="{StaticResource IslandTabButtonStyle}" Content="Focus" Tag="Focus" Click="OnTabClick"
                            Visibility="{x:Bind ViewModel.IsFocusTabAvailable, Mode=OneWay}" KeyDown="OnTabKeyDown" />
                </StackPanel>
            </Grid>

            <Button x:Name="SettingsButton" Style="{StaticResource IslandIconButtonStyle}" Width="32" Height="32" CornerRadius="16" FontSize="14"
                    Content="&#xE713;" HorizontalAlignment="Right" Click="OnSettings"
                    AutomationProperties.Name="Open Settings" />
        </Grid>

        <Grid x:Name="PanelHost" Grid.Row="1" Padding="4,0">
            <local:UsagePanel x:Name="UsageView" Visibility="{x:Bind ViewModel.IsUsageSelected, Mode=OneWay}" />
            <local:MusicPanel x:Name="MusicView" Visibility="{x:Bind ViewModel.IsMusicSelected, Mode=OneWay}" />
            <local:FocusPanel x:Name="FocusView" Visibility="{x:Bind ViewModel.IsFocusSelected, Mode=OneWay}" />
            <TextBlock Text="All modules are turned off. Turn one on in Settings." Style="{StaticResource CaptionTextStyle}"
                       Visibility="{x:Bind ViewModel.HasNoTabs, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
