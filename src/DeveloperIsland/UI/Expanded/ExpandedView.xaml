<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded island: 420 wide, radius 28. Header with icon tabs in the user's module order (the
    selection pill slides between them; the selected tab's name sits beside the tabs) and a settings
    button; one module at a time below.
-->
<UserControl
    x:Class="DeveloperIsland.UI.Expanded.ExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeveloperIsland.UI.Expanded">

    <Grid x:Name="Root" Width="420" Padding="16,14,16,18" RowSpacing="16" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="32" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TabHost" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border x:Name="TabIndicator" Width="32" Height="32" CornerRadius="16" Background="{StaticResource SurfaceRaisedBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="2" AutomationProperties.Name="Sections" TabFocusNavigation="Once" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="SectionName" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"
                           AutomationProperties.AccessibilityView="Raw" />
                <Button x:Name="StarButton" Style="{StaticResource IslandStarButtonStyle}" Click="OnStar" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource IslandIconButtonStyle}" Width="32" Height="32" CornerRadius="16" FontSize="14"
                    Content="&#xE713;" HorizontalAlignment="Right" Click="OnSettings"
                    AutomationProperties.Name="Open Settings" />
        </Grid>

        <!-- Panels scroll instead of being clipped if one ever outgrows the island (max 700 DIP minus the header). -->
        <ScrollViewer x:Name="PanelScroll" Grid.Row="1" MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                      VerticalScrollMode="Auto" IsTabStop="False">
        <Grid x:Name="PanelHost" Padding="4,0">
            <local:UsagePanel x:Name="UsageView" Visibility="Collapsed" />
            <local:MusicPanel x:Name="MusicView" Visibility="Collapsed" />
            <local:GitPanel x:Name="GitView" Visibility="Collapsed" />
            <local:GitHubPanel x:Name="GitHubView" Visibility="Collapsed" />
            <local:FocusPanel x:Name="FocusView" Visibility="Collapsed" />
            <local:CalendarPanel x:Name="CalendarView" Visibility="Collapsed" />
            <local:TasksPanel x:Name="TasksView" Visibility="Collapsed" />
            <local:SystemPanel x:Name="SystemView" Visibility="Collapsed" />
            <TextBlock x:Name="NoTabsText" Text="All modules are turned off. Turn one on in Settings." Style="{StaticResource CaptionTextStyle}"
                       Visibility="Collapsed" />
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
