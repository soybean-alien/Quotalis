<?xml version="1.0" encoding="utf-8"?>
<!--
    Today's usage of one AI tool. No card: grouping comes from spacing (Taste 4.4).
    Plan usage first (Claude: reported by Claude Code; Codex: its local limit records), then today's
    local usage: headline = fresh tokens; the breakdown names every recorded category (see TokenCounts).
-->
<UserControl
    x:Class="DeveloperIsland.UI.Expanded.ProviderSummary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:DeveloperIsland.UI.Components">

    <UserControl.Resources>
        <Style x:Key="BreakdownLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        </Style>
        <Style x:Key="BreakdownValue" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="2">
        <Grid Margin="0,-7,0,-5">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <components:ProviderMark Kind="{x:Bind ViewModel.ShortName, Mode=OneWay}" Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                         Visibility="{x:Bind ViewModel.IsActive, Mode=OneWay}"
                         AutomationProperties.Name="Session active" />
            </StackPanel>
            <Button x:Name="StarButton" Style="{StaticResource IslandStarButtonStyle}" HorizontalAlignment="Right" Margin="0,0,-9,0"
                    Content="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" Click="OnStar"
                    AutomationProperties.Name="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteLabel, Mode=OneWay}" />
        </Grid>

        <StackPanel Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" Spacing="2">
            <!-- Plan usage -->
            <Grid Margin="0,6,0,0" MinHeight="22">
                <TextBlock Text="Plan usage" Style="{StaticResource FineTextStyle}" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" CornerRadius="14" Padding="2" Background="{StaticResource SurfaceRaisedBrush}"
                        Visibility="{x:Bind ViewModel.HasBothPlanWindows, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="Plan window">
                        <Button x:Name="CurrentButton" Style="{StaticResource IslandSegmentButtonStyle}" Content="Current" Click="OnShowCurrent" />
                        <Button x:Name="WeeklyButton" Style="{StaticResource IslandSegmentButtonStyle}" Content="Weekly" Click="OnShowWeekly" />
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Visibility="{x:Bind ViewModel.HasPlan, Mode=OneWay}" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{x:Bind ViewModel.PlanPercentText, Mode=OneWay}" Style="{StaticResource FigureTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PlanWindowName, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                </StackPanel>
                <Grid Height="3" Margin="0,2,0,0" CornerRadius="1.5" Background="{StaticResource ProgressTrackBrush}">
                    <Rectangle Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{x:Bind ViewModel.PlanFraction, Mode=OneWay}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.PlanResetText, Mode=OneWay}" Style="{StaticResource FineTextStyle}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Visibility="{x:Bind ViewModel.HasNoPlan, Mode=OneWay}" Spacing="2">
                <TextBlock Text="Unavailable" Style="{StaticResource LabelTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.PlanUnavailableReason, Mode=OneWay}" Style="{StaticResource FineTextStyle}"
                           TextWrapping="Wrap" TextTrimming="None" MaxLines="2" MaxWidth="180" HorizontalAlignment="Left" />
                <Button Style="{StaticResource IslandPillButtonStyle}" Height="32" MinWidth="0" Padding="14,0" FontSize="12" Margin="0,4,0,0"
                        Content="Connect…" Click="OnConnectPlan" Visibility="{x:Bind ViewModel.CanConnectPlan, Mode=OneWay}"
                        AutomationProperties.Name="Connect Claude plan usage in Settings" />
            </StackPanel>

            <!-- Local usage today -->
            <TextBlock Text="Today on this PC" Style="{StaticResource FineTextStyle}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="5" Background="Transparent" ToolTipService.Placement="Bottom">
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{x:Bind ViewModel.DetailSummary, Mode=OneWay}" FontFamily="{StaticResource TextFont}" FontSize="12" TextWrapping="Wrap" />
                    </ToolTip>
                </ToolTipService.ToolTip>
                <TextBlock Text="{x:Bind ViewModel.TokensText, Mode=OneWay}" Style="{StaticResource FigureTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.TokensUnit, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </StackPanel>

            <Grid ColumnSpacing="12" RowSpacing="1" Margin="0,6,0,0" Visibility="{x:Bind ViewModel.HasUsageToday, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Input" Style="{StaticResource BreakdownLabel}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.InputText, Mode=OneWay}" Style="{StaticResource BreakdownValue}" />
                <TextBlock Grid.Row="1" Text="Cache write" Style="{StaticResource BreakdownLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CacheWriteText, Mode=OneWay}" Style="{StaticResource BreakdownValue}" />
                <TextBlock Grid.Row="2" Text="Output" Style="{StaticResource BreakdownLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.OutputText, Mode=OneWay}" Style="{StaticResource BreakdownValue}" />
                <TextBlock Grid.Row="3" Text="Cache read" Style="{StaticResource BreakdownLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.CacheReadText, Mode=OneWay}" Style="{StaticResource BreakdownValue}" />
                <TextBlock Grid.Row="4" Text="Processed" Style="{StaticResource BreakdownLabel}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ProcessedText, Mode=OneWay}" Style="{StaticResource BreakdownValue}" />
                <TextBlock Grid.Row="5" Text="Sessions" Style="{StaticResource BreakdownLabel}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.SessionsText, Mode=OneWay}" Style="{StaticResource BreakdownValue}" />
            </Grid>

            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"
                       Visibility="{x:Bind ViewModel.ShowValue, Mode=OneWay}">
                <Run Text="{x:Bind ViewModel.ValueText, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.ValueCaption, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{x:Bind ViewModel.DetailText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.ContextText, Mode=OneWay}" Style="{StaticResource FineTextStyle}" />
        </StackPanel>

        <StackPanel Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}" Spacing="4" Margin="0,4,0,0">
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.StatusHint, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextTrimming="None" MaxWidth="170" HorizontalAlignment="Left" />
        </StackPanel>
    </StackPanel>
</UserControl>
