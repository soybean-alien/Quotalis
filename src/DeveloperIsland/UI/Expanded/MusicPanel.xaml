<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately reduced: artwork, title, artist, timeline, three controls. Not a music app. -->
<UserControl
    x:Class="DeveloperIsland.UI.Expanded.MusicPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:DeveloperIsland.UI.Components">

    <Grid>
        <StackPanel Visibility="{x:Bind ViewModel.HasTrack, Mode=OneWay}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="72" Height="72">
                    <Border CornerRadius="12" Background="{StaticResource SurfaceRaisedBrush}" Visibility="{x:Bind ViewModel.HasNoArt, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="22" Style="{StaticResource IconTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <Border CornerRadius="12" Visibility="{x:Bind ViewModel.HasArt, Mode=OneWay}" AutomationProperties.Name="Album artwork">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind ViewModel.Art, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" Style="{StaticResource FineTextStyle}" Margin="0,4,0,0"
                               Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,18,0,0" Visibility="{x:Bind ViewModel.HasTimeline, Mode=OneWay}">
                <components:MediaTimeline x:Name="Timeline"
                                          Progress="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                          CanSeek="{x:Bind ViewModel.CanSeek, Mode=OneWay}" />
                <Grid Margin="0,2,0,0">
                    <TextBlock Typography.NumeralAlignment="Tabular" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" Style="{StaticResource FineTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" Style="{StaticResource FineTextStyle}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Style="{StaticResource IslandIconButtonStyle}" Width="44" Height="44" CornerRadius="22" Content="&#xE892;"
                        IsEnabled="{x:Bind ViewModel.CanPrevious, Mode=OneWay}" Click="OnPrevious"
                        AutomationProperties.Name="Previous track" />
                <Button x:Name="PlayPauseButton" Style="{StaticResource IslandPrimaryIconButtonStyle}"
                        Content="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanPlayPause, Mode=OneWay}" Click="OnPlayPause"
                        AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}" />
                <Button Style="{StaticResource IslandIconButtonStyle}" Width="44" Height="44" CornerRadius="22" Content="&#xE893;"
                        IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" Click="OnNext"
                        AutomationProperties.Name="Next track" />
            </StackPanel>
        </StackPanel>

        <!-- Empty state -->
        <Grid Visibility="{x:Bind ViewModel.HasNoTrack, Mode=OneWay}" ColumnSpacing="16" Padding="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource SurfaceRaisedBrush}" VerticalAlignment="Top">
                <FontIcon Glyph="&#xE8D6;" FontSize="18" Style="{StaticResource IconTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Nothing playing" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="Play something in Spotify, a browser or any media app. It shows up here." Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
