<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar: the next event large, then today's agenda (at most five rows). -->
<UserControl
    x:Class="DeveloperIsland.UI.Expanded.CalendarPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeveloperIsland.UI.Expanded"
    xmlns:vm="using:DeveloperIsland.ViewModels">

    <Grid>
        <local:ModuleStateView x:Name="StateView" Visibility="{x:Bind ViewModel.ShowState, Mode=OneWay}" />

        <StackPanel Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.AccessibleSummary, Mode=OneWay}">
            <TextBlock Text="Next" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.NextTitle, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" FontSize="17" Margin="0,6,0,0" />
            <TextBlock Text="{x:Bind ViewModel.NextLine, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0" />

            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,14,0,10" />

            <TextBlock Text="{x:Bind ViewModel.TodayHeader, Mode=OneWay}" Style="{StaticResource FineTextStyle}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Today, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgendaRow">
                        <Grid Height="28" ColumnSpacing="10" Opacity="{x:Bind RowOpacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Visibility="{x:Bind IsNotNow}" />
                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Visibility="{x:Bind IsNow}"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="200" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource FineTextStyle}" MaxWidth="90" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind ViewModel.MoreText, Mode=OneWay}" Style="{StaticResource FineTextStyle}" Margin="0,4,0,0"
                       Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.FailedText, Mode=OneWay}" Style="{StaticResource FineTextStyle}" Margin="0,8,0,0"
                       Visibility="{x:Bind ViewModel.HasFailed, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
