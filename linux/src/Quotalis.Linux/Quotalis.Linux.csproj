<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Quotalis.Linux</RootNamespace>
    <AssemblyName>quotalis</AssemblyName>
    <Version>0.1.2</Version>
    <!-- No libicu needed on the target; numbers and dates use one fixed format. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quotalis.Core\Quotalis.Core.csproj" />
    <InternalsVisibleTo Include="Quotalis.Tests" />
  </ItemGroup>

</Project>
